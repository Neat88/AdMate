    "react-dom": "19.1.0",
    "recharts": "^2.15.4",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/papaparse": "^5.3.16",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "postcss": "^8.5.6",
