{
  "name": "admate",
  "version": "0.1.0",
  "private": true,
  "description": "AdMate - AI marketing analyst for social advertising performance",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
