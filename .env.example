# ---------------------------------------------------------------------------
# AdMate configuration
# ---------------------------------------------------------------------------
# All variables are server-side only. Never prefix a secret with NEXT_PUBLIC_.

# Optional. When set, AI insight narratives are generated by Claude.
# When unset, AdMate runs in "Local analyst" mode: the same deterministic
# findings are rendered through built-in templates. Numbers are identical
# either way - the LLM only writes the explanation, never the maths.
ANTHROPIC_API_KEY=

# Optional. Model used for insight narration.
ADMATE_MODEL=claude-sonnet-5

# Optional. Model used by the in-report "Ask AdMate" assistant. Defaults to ADMATE_MODEL.
ADMATE_CHAT_MODEL=

# Optional. Model-backed assistant answers allowed per user per day (default 60).
# Past the limit, suggested questions are answered by the built-in analyst.
ADMATE_AI_DAILY_LIMIT=60

# Required in production. Signs session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Where the SQLite database file lives.
ADMATE_DB_PATH=./data/admate.db
